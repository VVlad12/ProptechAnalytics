<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Density</title>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
<style>
  html, body { margin: 0; height: 100%; }
  #map { height: 100%; background: #111; }
  #status {
    position: absolute; z-index: 1000; top: 10px; left: 60px;
    padding: 6px 10px; border-radius: 4px;
    background: rgba(0,0,0,.75); color: #fff;
    font: 13px/1.3 system-ui, sans-serif;
  }
  .legend {
    padding: 8px 10px; border-radius: 4px;
    background: rgba(0,0,0,.75); color: #fff;
    font: 12px/1.4 system-ui, sans-serif;
  }
  .legend .ramp {
    height: 10px; margin: 4px 0;
    background: linear-gradient(to right, #000004, #3b0f70, #8c2981, #de4968, #fe9f6d, #fcfdbf);
  }
  .legend .ticks { display: flex; justify-content: space-between; }
  #opacity-bar {
    position: absolute; z-index: 1000; left: 50%; bottom: 14px;
    transform: translateX(-50%);
    display: flex; align-items: center; gap: 8px;
    padding: 5px 10px; border-radius: 4px;
    background: rgba(0,0,0,.75); color: #fff;
    font: 12px/1.2 system-ui, sans-serif;
  }
  #opacity-bar input { width: 160px; accent-color: #de4968; }
  #opacity-bar span { width: 30px; text-align: right; font-variant-numeric: tabular-nums; }
</style>
</head>
<body>
<div id="map"></div>
<div id="opacity-bar">
  <label for="opacity">Overlay</label>
  <input id="opacity" type="range" min="0" max="100" value="75">
  <span id="opacity-val">75%</span>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
// Top of the colour ramp, for the legend label only. Must match the vmax
// baked into the tiles when they were generated — see magma.txt.
const VMAX = 50;

// Deepest zoom level present in tiles/. Beyond this Leaflet upscales the
// z-MAX_NATIVE_ZOOM tiles rather than showing gaps.
const MAX_NATIVE_ZOOM = 12;

// Bounding box of the tiled area, [[south, west], [north, east]].
// Whole-UK default; tighten it to your raster's real extent if narrower.
const DATA_BOUNDS = [[49.8, -8.7], [61.0, 2.0]];

const CARTO_ATTR = "&copy; OpenStreetMap, &copy; CARTO";

const baseLayers = {
  "Dark": L.tileLayer("https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png", {
    attribution: CARTO_ATTR, maxZoom: 19
  }),
  "Light": L.tileLayer("https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png", {
    attribution: CARTO_ATTR, maxZoom: 19
  }),
  "Streets": L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
    attribution: "&copy; OpenStreetMap contributors", maxZoom: 19
  }),
  "Satellite": L.tileLayer(
    "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}", {
    attribution: "Tiles &copy; Esri — Source: Esri, Maxar, Earthstar Geographics, and the GIS User Community",
    maxZoom: 19
  })
};

const map = L.map("map", { layers: [baseLayers["Dark"]] });
L.control.layers(baseLayers, null, { position: "topright" }).addTo(map);
map.fitBounds(DATA_BOUNDS);

// Legend text needs to stay readable on the pale basemaps.
map.on("baselayerchange", e => {
  const light = e.name === "Light" || e.name === "Streets";
  document.getElementById("map").style.background = light ? "#eee" : "#111";
});

const opacityInput = document.getElementById("opacity");
const opacityVal = document.getElementById("opacity-val");

// Keep the slider from panning/zooming the map underneath it.
const opacityBar = document.getElementById("opacity-bar");
L.DomEvent.disableClickPropagation(opacityBar);
L.DomEvent.disableScrollPropagation(opacityBar);

const density = L.tileLayer("tiles/{z}/{x}/{y}.png", {
  opacity: opacityInput.value / 100,
  maxNativeZoom: MAX_NATIVE_ZOOM,
  maxZoom: 19,
  bounds: DATA_BOUNDS,
  // tilePane holds the basemaps; overlayPane always paints above them, so
  // switching basemap can never bury the density layer.
  pane: "overlayPane",
  attribution: "Density &copy; DXAN"
}).addTo(map);

opacityInput.addEventListener("input", () => {
  density.setOpacity(opacityInput.value / 100);
  opacityVal.textContent = `${opacityInput.value}%`;
});

const legend = L.control({ position: "bottomright" });
legend.onAdd = () => {
  const div = L.DomUtil.create("div", "legend");
  div.innerHTML = `count per km²
    <div class="ramp"></div>
    <div class="ticks"><span>0</span><span>${VMAX}+</span></div>`;
  return div;
};
legend.addTo(map);
</script>
</body>
</html>
